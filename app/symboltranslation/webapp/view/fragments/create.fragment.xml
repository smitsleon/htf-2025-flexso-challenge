<core:FragmentDefinition xmlns:smartfield="sap.ui.comp.smartfield"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core">
    <!-- HACK THE FUTURE Challenge: several properties are missing to make this a succesful save-->
    <Dialog id="_IDGenDialog" title="Add new symbol" draggable="true">
        <content>
            <VBox class="sapUiSmallMargin" id="formContainer">
                <f:SimpleForm id="SimpleFormChangeColumn_twoGroups234" editable="true"
                    layout="ColumnLayout" columnsM="2" columnsL="2" columnsXL="2">
                    <f:content>
                        <Label id="_IDGenLabel2" text="Icon" />
                        <Input id="_IDGenInput1" required="true" value="{create>/symbol}" />
                        <Label id="_IDGenLabel3" text="Where abouts" />
                        <Input id="_IDGenInput2" required="true" value="{create>/whereFound}" />
                        <Label id="_IDGenLabel4" text="Language" />
                        <ComboBox id="_IDGenComboBox1" 
                            required="true" 
                            selectedKey="{create>/language}"
                            items="{/Languages}">
                            <core:Item key="{language}" text="{language}" />
                        </ComboBox>
                    </f:content>
                </f:SimpleForm>
            </VBox>
        </content>
        <beginButton>
            <Button id="_IDGenButton5" text="Save" type="Accept" press="save" />
        </beginButton>
        <endButton>
            <Button id="_IDGenButton4" text="Cancel" type="Reject" press="closeDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>